{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/warengonzaga/explainer-studio/blob/dev/docs/avatar-pack.schema.json",
  "title": "Explainer Studio Avatar Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "id", "name", "version", "creator", "license", "license_file", "sheets", "face"],
  "properties": {
    "format_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "creator": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "license_file": {"enum": ["LICENSE", "TERMS.md"]},
    "sheets": {
      "type": "object", "additionalProperties": false,
      "required": ["poses", "eyes", "mouth"],
      "properties": {
        "poses": {"$ref": "#/$defs/sheetGroups/poses"},
        "eyes": {"$ref": "#/$defs/sheetGroups/eyes"},
        "mouth": {"$ref": "#/$defs/sheetGroups/mouth"}
      }
    },
    "face": {
      "type": "object", "additionalProperties": false,
      "required": ["eyes", "mouth"],
      "properties": {"eyes": {"$ref": "#/$defs/rect"}, "mouth": {"$ref": "#/$defs/rect"}}
    }
  },
  "$defs": {
    "rect": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 4, "maxItems": 4},
    "sheet": {"type": "object", "additionalProperties": false, "required": ["path", "frames"], "properties": {"path": {"type": "string", "minLength": 1}, "frames": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/rect"}}}},
    "poseTalkingFrames": {"type": "object", "required": ["idle", "present", "like", "thinking", "idea", "celebrate"], "additionalProperties": false, "properties": {"idle": {"$ref": "#/$defs/rect"}, "present": {"$ref": "#/$defs/rect"}, "like": {"$ref": "#/$defs/rect"}, "thinking": {"$ref": "#/$defs/rect"}, "idea": {"$ref": "#/$defs/rect"}, "celebrate": {"$ref": "#/$defs/rect"}}},
    "posePointingFrames": {"type": "object", "required": ["top_left", "left", "bottom_left", "top_right", "right", "bottom_right", "viewer"], "additionalProperties": false, "properties": {"top_left": {"$ref": "#/$defs/rect"}, "left": {"$ref": "#/$defs/rect"}, "bottom_left": {"$ref": "#/$defs/rect"}, "top_right": {"$ref": "#/$defs/rect"}, "right": {"$ref": "#/$defs/rect"}, "bottom_right": {"$ref": "#/$defs/rect"}, "viewer": {"$ref": "#/$defs/rect"}}},
    "poseEmotionFrames": {"type": "object", "required": ["smile", "grin", "laugh", "sad", "worried", "surprised", "angry"], "additionalProperties": false, "properties": {"smile": {"$ref": "#/$defs/rect"}, "grin": {"$ref": "#/$defs/rect"}, "laugh": {"$ref": "#/$defs/rect"}, "sad": {"$ref": "#/$defs/rect"}, "worried": {"$ref": "#/$defs/rect"}, "surprised": {"$ref": "#/$defs/rect"}, "angry": {"$ref": "#/$defs/rect"}}},
    "eyeTalkingFrames": {"type": "object", "required": ["open", "closed", "top_left", "left", "bottom_left", "top_right", "right", "bottom_right"], "additionalProperties": false, "properties": {"open": {"$ref": "#/$defs/rect"}, "closed": {"$ref": "#/$defs/rect"}, "top_left": {"$ref": "#/$defs/rect"}, "left": {"$ref": "#/$defs/rect"}, "bottom_left": {"$ref": "#/$defs/rect"}, "top_right": {"$ref": "#/$defs/rect"}, "right": {"$ref": "#/$defs/rect"}, "bottom_right": {"$ref": "#/$defs/rect"}}},
    "eyeEmotionFrames": {"type": "object", "required": ["smile", "grin", "laugh", "sad", "worried", "surprised", "angry"], "additionalProperties": false, "properties": {"smile": {"$ref": "#/$defs/rect"}, "grin": {"$ref": "#/$defs/rect"}, "laugh": {"$ref": "#/$defs/rect"}, "sad": {"$ref": "#/$defs/rect"}, "worried": {"$ref": "#/$defs/rect"}, "surprised": {"$ref": "#/$defs/rect"}, "angry": {"$ref": "#/$defs/rect"}}},
    "mouthTalkingFrames": {"type": "object", "required": ["rest", "closed", "small", "open", "wide"], "additionalProperties": false, "properties": {"rest": {"$ref": "#/$defs/rect"}, "closed": {"$ref": "#/$defs/rect"}, "small": {"$ref": "#/$defs/rect"}, "open": {"$ref": "#/$defs/rect"}, "wide": {"$ref": "#/$defs/rect"}}},
    "mouthEmotionFrames": {"type": "object", "required": ["smile", "grin", "laugh", "sad", "worried", "surprised", "angry"], "additionalProperties": false, "properties": {"smile": {"$ref": "#/$defs/rect"}, "grin": {"$ref": "#/$defs/rect"}, "laugh": {"$ref": "#/$defs/rect"}, "sad": {"$ref": "#/$defs/rect"}, "worried": {"$ref": "#/$defs/rect"}, "surprised": {"$ref": "#/$defs/rect"}, "angry": {"$ref": "#/$defs/rect"}}},
    "sheetGroups": {
      "poses": {"type": "object", "additionalProperties": false, "required": ["talking", "pointing", "emotion"], "properties": {"talking": {"$ref": "#/$defs/sheet", "properties": {"frames": {"$ref": "#/$defs/poseTalkingFrames"}}}, "pointing": {"$ref": "#/$defs/sheet", "properties": {"frames": {"$ref": "#/$defs/posePointingFrames"}}}, "emotion": {"$ref": "#/$defs/sheet", "properties": {"frames": {"$ref": "#/$defs/poseEmotionFrames"}}}}},
      "eyes": {"type": "object", "additionalProperties": false, "required": ["talking", "emotion"], "properties": {"talking": {"$ref": "#/$defs/sheet", "properties": {"frames": {"$ref": "#/$defs/eyeTalkingFrames"}}}, "emotion": {"$ref": "#/$defs/sheet", "properties": {"frames": {"$ref": "#/$defs/eyeEmotionFrames"}}}}},
      "mouth": {"type": "object", "additionalProperties": false, "required": ["talking", "emotion"], "properties": {"talking": {"$ref": "#/$defs/sheet", "properties": {"frames": {"$ref": "#/$defs/mouthTalkingFrames"}}}, "emotion": {"$ref": "#/$defs/sheet", "properties": {"frames": {"$ref": "#/$defs/mouthEmotionFrames"}}}}}
    }
  }
}
